# mypy
.mypy_cache/

# NOTE: this used to be `**/benchmark` + `**/results`, which silently untracked the whole
# PF-belief encoder benchmark (experiments/benchmark/, set_transformer/rl/benchmark/) and
# every run record it produces. Both are source / paper data and must be committed; only
# the heavy per-run artifacts below are ignored.
results/**/*.zip
results/**/vecnormalize.pkl
results/**/events.out.tfevents.*
*.pkl
*.log


# data
/set_transformer/data/raw/*.json
/set_transformer/data/numpy/*.npy
/set_transformer/data/torch/*.pyt

/models/
sb3_e2e_tensorboard/

# SB3 training artifacts
sb3_*_logs/
sb3_*_models/
sanity_check_*_logs/
sanity_check_*_models/
# The globs above miss the un-infixed names, so list them too. These hold
# TensorBoard events + eval .npz from sanity/phase runs, not source.
sanity_check_logs/
sanity_check_models/
phase3_logs/
phase4_eval_logs/

# Timestamped experiment run output (logs, checkpoints, TensorBoard, etc.)
/runs/

# ST training run output (NOT to be confused with the source-tree
# experiments/ directory, which holds per-domain pipeline scripts).
# Per-script run dirs land at the repo root or under data/ — list those
# explicitly rather than ignoring all of experiments/.
data/*.npy
data/*.npz
wandb/

# Run/eval output artifacts
logs/
particle_reconstruction_results/
trajectory_renders/
*.gif
*.csv
*.npz
*.zip
*.png
/*.npy

# ...but benchmark run records and their aggregated tables/figures ARE the paper's data.
# (Negations come after the broad rules above so they win; the models/tfevents ignored
# near the top of this file keep the heavy artifacts out.)
!results/**/evaluations.npz
!results/**/meta.json
!results/aggregated/*.csv
!results/figures/*.png
!results/figures/*.svg

# Precomputed pairwise-EMD matrices for the latent-alignment loss. 1.6 GB each and fully
# regenerable from the committed point splits via 8_precompute_emd_matrix.py. The small
# .json sidecar (metric settings + histogram stats) is deliberately NOT ignored — it is
# the provenance record for whichever matrix a run was aligned against.
experiments/*/data*/emd_*.npy
experiments/*/data*/emd_*.progress.json
experiments/benchmark/pretrain/data/**/*.npy
experiments/benchmark/pretrain/data/**/emd_*.progress.json
# Pretrained encoder weights are large and regenerable from the committed pipeline; the
# meta.json (arch, alignment settings, val EMD / val_r) is the provenance record.
experiments/benchmark/pretrained/**/*.pt
experiments/benchmark/pretrained/**/history.npz

# ST experiment run artifacts (source lives in experiments/*/*.py,
# outputs land in sibling data/, figures/, runs/ dirs).
*.pt
experiments/*/runs/
experiments/*/data/*.npy
experiments/*/data/*.npz
experiments/*/figures/*.svg
experiments/*/figures/*.png
experiments/*/figures/*.csv
experiments/*/figures/*.npy
# Odd-Even episode renders (regenerable via experiments/odd_even/viz/animate_episode.py)
experiments/odd_even/viz/out/

# Pairwise-EMD matrices for latent alignment (4 N^2 bytes, regenerable via
# experiments/ant_tag/2b_precompute_emd.py). The small .json sidecar beside
# each one is the provenance record and is NOT ignored.
experiments/*/data/*_emd.npy
experiments/*/data/*_emd.progress.json

# Pretraining / probe run output of the per-domain experiment scripts
# (3_pretrain_st_belief.py -> experiments/<domain>/experiments/<run>/ with
# checkpoints, history.json, probe_results.json; the blur-sweep Sinkhorn runs
# under experiments/ant_tag/experiments/). Regenerable; run dirs are named in
# domain_mds/. The checkpoints inside were already ignored via *.pt.
experiments/*/experiments/
# nohup stdout of RL launches
experiments/odd_even/rl_logs/
*.nohup
